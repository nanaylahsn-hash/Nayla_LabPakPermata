generator client {
 provider = "prisma-client-js"
}
datasource db {
 provider = "sqlite"
 url = env("DATABASE_URL")
}
model Pendaftar {
 id Int @id @default(autoincrement())
 nama String
 email String @unique
 pesan String?
 createdAt DateTime @default(now())
}

model Buku {
 id String @id @default(cuid())
 judul String
 penulis String
 kategori String
 tahun Int
 stok Int
 deskripsi String @default("")
 createdAt DateTime @default(now())
}
